# Prisma Database Connection
# Ganti dengan connection string dari Supabase atau Neon:
# Contoh Neon: postgresql://neondb_owner:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Contoh Supabase: postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# Direct URL (Wajib diisi jika menggunakan Supabase Connection Pooler untuk prisma db push/migrate)
# DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
